# API Gateway Environment Variables
# Copy to .env and adjust as needed

# Server port (gateway is the single public entry point)
PORT="3000"

# JWT secret (must match auth-service/gateway)
JWT_SECRET="dev-secret-change-in-production"

# Upstream service addresses for proxy routing
AUTH_URL="http://localhost:3001"
PRODUCT_URL="http://localhost:3002"
ORDER_URL="http://localhost:3003"

# Rate limits (requests per window)
AUTH_RATE_LIMIT="30"
GENERAL_RATE_LIMIT="300"
