# Auth Service Environment Variables
# Copy to .env and adjust as needed

# PostgreSQL connection for auth_db
DATABASE_URL="postgres://dev:dev@localhost:5432/auth_db"

# Secret used to sign and verify access tokens (JWT)
JWT_SECRET="dev-secret-change-in-production"

# How long the access token is valid
ACCESS_TTL="15m"

# How many days refresh tokens remain valid
REFRESH_TTL_DAYS="7"

# Kafka brokers (leave empty if Kafka isn't running)
KAFKA_BROKERS=""

# Server port
PORT="3001"
