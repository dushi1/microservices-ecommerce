# Order Service Environment Variables
# Copy to .env and adjust as needed

# PostgreSQL connection for order_db
DATABASE_URL="postgres://dev:dev@localhost:5432/order_db"

# JWT secret (must match auth-service/gateway)
JWT_SECRET="dev-secret-change-in-production"

# gRPC addresses for other services
INVENTORY_URL="localhost:50052"
PAYMENT_URL="localhost:50051"
PRODUCT_URL="http://localhost:3002"

# Kafka brokers (leave empty if Kafka isn't running)
KAFKA_BROKERS=""

# Server port
PORT="3003"
