# Product Service Environment Variables
# Copy to .env and adjust as needed

# PostgreSQL connection for product_db
DATABASE_URL="postgres://dev:dev@localhost:5432/product_db"

# Redis connection for caching
REDIS_URL="redis://localhost:6379"

# Direct inventory_db connection (TEMP — becomes gRPC GetStock)
INVENTORY_DATABASE_URL="postgres://dev:dev@localhost:5432/inventory_db"

# JWT secret (must match auth-service/gateway)
JWT_SECRET="dev-secret-change-in-production"

# Inventory service address
INVENTORY_URL="localhost:50052"

# Kafka brokers (leave empty if Kafka isn't running)
KAFKA_BROKERS=""

# Server port
PORT="3002"
